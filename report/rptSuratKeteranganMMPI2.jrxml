                     surat_keterangan_mmpi2.kd_dokter,dokter.nm_dokter,pasien.pekerjaan,pasien.pnd,pasien.alamat,pasien.jk
                      from surat_keterangan_mmpi2 inner join reg_periksa on surat_keterangan_mmpi2.no_rawat=reg_periksa.no_rawat 
