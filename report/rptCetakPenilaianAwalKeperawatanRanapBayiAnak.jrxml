					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["Susunan Saraf Pusat : \nKepala : "+$F{saraf_pusat_kepala}+" ("+$F{saraf_pusat_kepala_keterangan}+")    Wajah : "+$F{saraf_pusat_wajah}+" ("+$F{saraf_pusat_wajah_keterangan}+")    Leher : "+$F{saraf_pusat_leher}+"    Kejang : "+$F{saraf_pusat_kejang}+" ("+$F{saraf_pusat_kejang_keterangan}+")    Sensorik : "+$F{saraf_pusat_sensorik}+"\n\nKardiovaskuler : \nPulsasi : "+$F{kardiovaskuler_pulsasi}+"   Sirkulasi : "+$F{kardiovaskuler_sirkulasi}+" ("+$F{kardiovaskuler_sirkulasi_keterangan}+")    Denyut Nadi : "+$F{kardiovaskuler_denyut_nadi}+"\n\nRespirasi : \nRetraksi : "+$F{respirasi_retraksi}+"     Pola Nafas : "+$F{respirasi_pola_nafas}+"     Suara Nafas : "+$F{respirasi_suara_nafas}+"    Batuk dan Sekresi : "+$F{respirasi_batuk}+"     Volume : "+$F{respirasi_volume}+"    Jenis Pernafasan : "+$F{respirasi_jenis_pernapasan}+" ("+$F{respirasi_jenis_pernapasan_keterangan}+")     Irama : "+$F{respirasi_irama}+"\n\nGastrointestinal : \nMulut : "+$F{gastro_mulut}+" ("+$F{gastro_mulut_keterangan}+")     Tenggorokan : "+$F{gastro_tenggorakan}+" ("+$F{gastro_tenggorakan_keterangan}+")     Lidah : "+$F{gastro_lidah}+" ("+$F{gastro_lidah_keterangan}+")    Abdomen : "+$F{gastro_abdomen}+" ("+$F{gastro_abdomen_keterangan}+")     Gigi : "+$F{gastro_gigi}+" ("+$F{gastro_gigi_keterangan}+")    Usus : "+$F{gastro_usus}+"     Anus : "+$F{gastro_anus}+"\n\nNeurologi : \nSensorik : "+$F{neurologi_sensorik}+"      Penglihatan : "+$F{neurologi_pengilihatan}+" ("+$F{neurologi_pengilihatan_keterangan}+")     Alat_Bantu_Penglihatan : "+$F{neurologi_alat_bantu_penglihatan}+"     Motorik : "+$F{neurologi_motorik}+"      Pendenganran : "+$F{neurologi_pendengaran}+"     Bicara : "+$F{neurologi_bicara}+" ("+$F{neurologi_bicara_keterangan}+")     Otot : "+$F{neurologi_otot}+"\n\nIntegument : \nKulit : "+$F{inte_kulit}+"      Warna Kulit : "+$F{inte_warna_kulit}+"      Tugor : "+$F{inte_tugor}+"     Resiko Dekubitus : "+$F{inte_decubi}+"      \n\nMuskuloskletal : \nOdema : "+$F{musku_odema}+" ("+$F{musku_odema_keterangan}+")     Pegerakan Sendi : "+$F{musku_pegerakansendi}+"      Otot : "+$F{musku_otot}+"    Fraktur : "+$F{musku_fraktur}+" ("+$F{musku_fraktur_keterangan}+")    Nyeri_Sendi : "+$F{musku_nyerisendi}+" ("+$F{musku_nyerisendi_keterangan}+")    \n\nEliminasi : \nBAB_Frekuensi : "+$F{eliminasi_bab_frekuensi}+" /  "+$F{eliminasi_bab_frekuensi_per}+"     BAB_Konsistensi : "+$F{eliminasi_bab_konsistesi}+"     BAB_Warna : "+$F{eliminasi_bab_warna}+"     BAK_Frekuensi : "+$F{eliminasi_bak_frekuensi}+" / "+$F{eliminasi_bak_frekuensi_per}+"    BAK_Warna : "+$F{eliminasi_bak_warna}+"    BAK_Lain-lain : "+$F{eliminasi_bak_lainlain}]]></textFieldExpression>
