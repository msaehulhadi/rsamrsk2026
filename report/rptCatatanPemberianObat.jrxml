	<queryString>
		<![CDATA[select reg_periksa.no_rawat,pasien.no_rkm_medis,pasien.nm_pasien,reg_periksa.umurdaftar,reg_periksa.sttsumur,
                    pasien.jk,pasien.tgl_lahir,catatan_pemberian_obat.tgl_perawatan,catatan_pemberian_obat.jam_rawat,catatan_pemberian_obat.nm_obat,
                    catatan_pemberian_obat.rute,catatan_pemberian_obat.dosis,catatan_pemberian_obat.signa,catatan_pemberian_obat.nip,petugas.nama,pegawai.bidang 
                    from catatan_pemberian_obat inner join reg_periksa on catatan_pemberian_obat.no_rawat=reg_periksa.no_rawat 
                    inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis 
                    inner join petugas on catatan_pemberian_obat.nip=petugas.nip inner join pegawai on petugas.nip=pegawai.nik]]>
	</queryString>
